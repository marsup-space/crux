.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.lock
pubspec.lock

# Reproducibly fetched from third_party/manifest.json.
/third_party/bin/
/third_party/licenses/

.idea/
.vscode/
*.iml

# macOS Finder
.DS_Store

.fvm/
.env

# Research references (external repos)
.research/
design/

# Local scratch output
.worktrees/
warmup.log

# GitNexus agent runtime artifacts (auto-generated context for AI agents)
# The agent (Crux/Claude/Codex/...) reads/writes these locally; they must
# not leak into the project repo.
AGENTS.md
CLAUDE.md
.claude/
.codegraph/

# Local chat-input skill scaffold (used during development to test
# the picker; not part of the shipped app).
.crux/
# ...but spec widgets (Phase B: `.crux/widgets/*.toml`) ARE source —
# they ship with the repo so every session gets the seeded widgets.
# Anchored to the repo root: a stray `.crux` cache deeper in the tree
# (e.g. lib/src/services/.crux/semble_cache/) stays ignored.
!/.crux/
!/.crux/widgets/
!/.crux/widgets/**

# Semble semantic-search index cache (written by the search isolate
# into <root>/.cache/semble; not source).
.cache/

# Semble model files fetched locally by the semantic search engine
# (binary model, not source — see third_party/manifest.json).
/third_party/semblemodel/
