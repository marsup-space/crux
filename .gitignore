# https://dart.dev/guides/libraries/private-files
# Created by `dart pub`
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.lock
pubspec.lock

# Reproducibly fetched from third_party/manifest.json.
/third_party/bin/
/third_party/licenses/

.idea/
.vscode/
*.iml

# macOS Finder
.DS_Store

.fvm/
.env

# Research references (external repos)
.research/
design/

# The product website is a separate repository — its own history and deploy
# origin — checked out inside this tree. crux has never tracked it, and it is
# deliberately NOT a submodule: `git add .` would stage it as a gitlink with no
# .gitmodules entry, i.e. an empty shell for everyone else.
#
# It has to stay at this path: its build scripts read `../install.sh` /
# `../install.ps1` and `git -C .. tag` from this checkout, and write the manual
# back to `../docs/manual` (see website/README.md).
#
# Ignoring it spares it from `git clean -fd`; `git clean -fdx` still removes it,
# and its `main` has no upstream branch.
/website/

# Local scratch output
.worktrees/
*.log
# `script` command default transcript (created when run without a filename)
typescript
/tmp/

# Local release builds. Published binaries are produced by the release workflow.
/bin/*.dill
/bin/*.exe

# GitNexus agent runtime artifacts (auto-generated context for AI agents)
# The agent (Crux/Claude/Codex/...) reads/writes these locally; they must
# not leak into the project repo.
AGENTS.md
CLAUDE.md
.claude/
.codegraph/

# Local chat-input skill scaffold (used during development to test
# the picker; not part of the shipped app).
.crux/
# ...but spec plugins (`.crux/plugins/*.toml`) ARE source — they ship
# with the repo so every session gets the seeded plugins. The legacy
# `.crux/widgets/` directory stays whitelisted too: specs there are
# still scanned (compat) and migrate to plugins/ over time.
# Anchored to the repo root: a stray `.crux` cache deeper in the tree
# (e.g. lib/src/services/.crux/semble_cache/) stays ignored.
!/.crux/
!/.crux/plugins/
!/.crux/plugins/**
!/.crux/widgets/
!/.crux/widgets/**

# Local-only plugin spec: the dev-harness control panel is per-machine
# dev tooling, not source — keep it out of the repo (it stays on disk).
/.crux/plugins/dev-harness.toml

# Per-machine plan-doc version history (`.crux/plans/<sessionId>/…`,
# written by PlanDocStore). Not source; also anchors the autocomplete
# heuristic — see `listKnownPlanNames`.
/.crux/plans/

# Runtime heartbeat for the comfy-monitor plugin (rewritten every few
# seconds by /tmp/comfy-sleep-monitor.py; regenerated on demand — never
# source). Only the plugin spec under .crux/plugins/ ships.
/.crux/comfy-monitor-status.json

# Semble semantic-search index cache (written by the search isolate
# into <root>/.cache/semble; not source).
.cache/

# Semble model files fetched locally by the semantic search engine
# (binary model, not source — see third_party/manifest.json).
/third_party/semblemodel/
